{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputCXR",
  "description": "Schema for raw incoming Chest X-Ray radiograph metadata and pixel container",
  "type": "object",
  "required": [
    "image_id",
    "file_path",
    "width",
    "height",
    "channels",
    "format"
  ],
  "properties": {
    "image_id": {
      "type": "string"
    },
    "file_path": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "channels": {
      "type": "integer",
      "enum": [
        1,
        3
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "PNG",
        "JPEG",
        "DICOM"
      ]
    },
    "patient_age": {
      "type": [
        "integer",
        "null"
      ]
    },
    "patient_sex": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "M",
        "F",
        "O",
        null
      ]
    }
  }
}
