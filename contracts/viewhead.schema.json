{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViewheadResult",
  "description": "Output schema from P1 CXR view orientation classifier",
  "type": "object",
  "required": [
    "image_id",
    "predicted_orientation",
    "confidence",
    "is_valid_pa"
  ],
  "properties": {
    "image_id": {
      "type": "string"
    },
    "predicted_orientation": {
      "type": "string",
      "enum": [
        "PA",
        "AP",
        "LATERAL",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "is_valid_pa": {
      "type": "boolean"
    }
  }
}
