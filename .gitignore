# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & virtualenvs
.env
.venv
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE configurations
.vscode/
.idea/
*.swp
*.swo

# Large medical data files (Never commit raw datasets)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.dcm
*.dicom
*.nii
*.nii.gz
*.zip
*.tar
*.tar.gz
*.7z

# Model checkpoints and heavy artifacts
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/calibration/*
!artifacts/calibration/.gitkeep
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt

# Training & Eval runs
runs/*
!runs/.gitkeep
wandb/

# Logs
logs/*
!logs/.gitkeep
*.log

# Generated PDF reports
report/output/*
!report/output/.gitkeep
